<UserControl x:Class="OASX.Views.DevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="设备管理" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
            <TextBlock Text="切换各调度器使用的模拟器（只改配置，下次启动脚本生效）"
                       FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource OasTextTertiaryBrush}" />
        </StackPanel>

        <!-- 工具条 -->
        <Border Grid.Row="1" CornerRadius="{StaticResource RadiusCard}" Padding="12"
                Margin="0,0,0,12"
                Background="{DynamicResource OasSurfaceBrush}"
                BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="调度器" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource OasTextTertiaryBrush}" />
                <ComboBox x:Name="ConfigSelector" MinWidth="180" MinHeight="34"
                          VerticalAlignment="Center"
                          SelectionChanged="ConfigSelector_SelectionChanged" />
                <ui:Button MinWidth="72" MinHeight="34" Margin="12,0,0,0"
                           Content="刷新" Click="Refresh_Click" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontSize="12"
                           Foreground="{DynamicResource OasTextTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 内容：当前设备 + 实例列表 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 当前设备卡 -->
            <Border Grid.Row="0" CornerRadius="{StaticResource RadiusCard}" Padding="14"
                    Margin="0,0,0,12"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="当前设备" FontSize="12"
                               Foreground="{DynamicResource OasTextTertiaryBrush}" />
                    <TextBlock x:Name="CurrentSerialText" Text="—" FontSize="17"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource OasTextPrimaryBrush}" />
                    <TextBlock x:Name="CurrentMetaText" Text="" FontSize="11"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource OasTextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 实例列表 -->
            <Border Grid.Row="1" CornerRadius="{StaticResource RadiusCard}"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="InstanceList" BorderThickness="0"
                             Background="Transparent" Padding="6"
                             SelectionMode="Single"
                             SelectionChanged="InstanceList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="{Binding Badge}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource OasAccentBrush}" />
                                    </Grid>
                                    <TextBlock Text="{Binding SubText}" FontSize="11"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource OasTextTertiaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Text="未发现实例（需模拟器已启动）"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource OasTextTertiaryBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
