<UserControl x:Class="OASX.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">

            <TextBlock Text="关于" FontSize="24" FontWeight="SemiBold"
                       FontFamily="{StaticResource AppFontFamily}" Margin="0,0,0,16" />

            <!-- ============ 应用 ============ -->
            <Border CornerRadius="{StaticResource RadiusCard}" Padding="20" Margin="0,0,0,16"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Width="56" Height="56" Margin="0,0,16,0"
                               Source="pack://application:,,,/Assets/appicon.png" />
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="OASX" FontSize="22" FontWeight="SemiBold"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                <TextBlock x:Name="VersionText" Text="v—" FontSize="13"
                                           Margin="10,0,0,2" VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource OasTextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="阴阳师自动化脚本 · Windows 桌面客户端"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Height="1" Margin="0,16"
                               Fill="{DynamicResource OasBorderBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Server24" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="OAS 后端" FontSize="13"
                                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
                            <TextBlock x:Name="BackendText" Text="—" FontSize="12"
                                       Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" x:Name="BackendDot"
                                     Fill="{DynamicResource OasTextTertiaryBrush}" />
                            <TextBlock x:Name="BackendStateText" Text="—" FontSize="12" Margin="7,0,0,0"
                                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Margin="0,14"
                               Fill="{DynamicResource OasBorderBrush}" />
                    <!-- 仓库与反馈（点击用系统浏览器打开） -->
                    <Grid Cursor="Hand" Background="Transparent" Margin="0,2,0,10"
                          MouseLeftButtonUp="Repo_Click">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Code24" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="GitHub 仓库" FontSize="13"
                                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
                            <TextBlock Text="github.com/Eiyuuzaki/OASX"
                                       FontSize="12"
                                       Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OasTextTertiaryBrush}" />
                    </Grid>
                    <Grid Cursor="Hand" Background="Transparent"
                          MouseLeftButtonUp="Issues_Click">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="ChatHelp24" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="问题反馈" FontSize="13"
                                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
                            <TextBlock Text="github.com/Eiyuuzaki/OASX/issues"
                                       FontSize="12"
                                       Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OasTextTertiaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 组件与致谢 ============ -->
            <TextBlock Text="组件与致谢" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource OasTextPrimaryBrush}" Margin="0,0,0,6" />
            <Border CornerRadius="{StaticResource RadiusCard}" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <StackPanel x:Name="CreditsPanel" />
            </Border>

            <!-- ============ 环境信息 ============ -->
            <TextBlock Text="环境信息" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource OasTextPrimaryBrush}" Margin="0,0,0,6" />
            <Border CornerRadius="{StaticResource RadiusCard}" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <StackPanel x:Name="EnvPanel" />
            </Border>

            <!-- ============ 更新 ============ -->
            <TextBlock Text="更新" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource OasTextPrimaryBrush}" Margin="0,0,0,6" />
            <Border CornerRadius="{StaticResource RadiusCard}" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <!-- 状态行：点击检查 -->
                    <Grid x:Name="UpdateRow" Cursor="Hand" Background="Transparent"
                          MinHeight="44" Margin="0,2"
                          MouseLeftButtonUp="CheckUpdate_Click">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="ArrowSync24" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="检查更新" FontSize="13"
                                           Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                <TextBlock x:Name="VersionInlineText" Text="v—" FontSize="12"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource OasTextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatusText" Text="点击检查是否有新版本"
                                       FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OasTextTertiaryBrush}" />
                    </Grid>

                    <!-- 有新版本时展开：版本对比 + 更新说明 + 操作 -->
                    <StackPanel x:Name="UpdateDetailPanel" Visibility="Collapsed"
                                Margin="0,12,0,0">
                        <Rectangle Height="1" Margin="0,0,0,12"
                                   Fill="{DynamicResource OasBorderBrush}" />

                        <!-- 版本对比 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="当前" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OasTextTertiaryBrush}" />
                            <TextBlock x:Name="CurrentVerText" Text="v—" FontSize="13"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OasTextSecondaryBrush}" />
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="12" Margin="10,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource OasTextTertiaryBrush}" />
                            <TextBlock Text="最新" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OasTextTertiaryBrush}" />
                            <TextBlock x:Name="LatestVerText" Text="v—" FontSize="15"
                                       FontWeight="SemiBold" Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OasAccentBrush}" />
                        </StackPanel>

                        <!-- 更新说明 -->
                        <TextBlock Text="更新说明" FontSize="11" Margin="0,4,0,4"
                                   Foreground="{DynamicResource OasTextTertiaryBrush}" />
                        <Border CornerRadius="6" Padding="10" MaxHeight="160"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ReleaseNoteText" Text="" FontSize="11"
                                           TextWrapping="Wrap" LineHeight="17"
                                           Foreground="{DynamicResource OasTextPrimaryBrush}" />
                            </ScrollViewer>
                        </Border>

                        <!-- 操作 -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button x:Name="OpenReleaseButton" MinWidth="120" Height="32"
                                       Content="打开发布页" Click="OpenRelease_Click" />
                            <ui:Button x:Name="CopyLinkButton" MinWidth="100" Height="32"
                                       Margin="8,0,0,0" Content="复制下载链接"
                                       Click="CopyLink_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="本软件为第三方桌面客户端，与网易及阴阳师官方无关。字体 MiSans 由小米发布（免费商用）；界面组件 WPF-UI（MIT）。"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource OasTextTertiaryBrush}" Margin="0,0,0,8" />
        </StackPanel>
    </ScrollViewer>
</UserControl>