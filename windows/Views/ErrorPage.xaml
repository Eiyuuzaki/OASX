<UserControl x:Class="OASX.Views.ErrorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="错误记录" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
            <TextBlock Text="运行异常时后端自动归档的日志与截图"
                       FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource OasTextTertiaryBrush}" />
        </StackPanel>

        <!-- 工具条 -->
        <Border Grid.Row="1" CornerRadius="{StaticResource RadiusCard}" Padding="12"
                Margin="0,0,0,12"
                Background="{DynamicResource OasSurfaceBrush}"
                BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="范围" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource OasTextTertiaryBrush}" />
                <ComboBox x:Name="ScopeSelector" MinWidth="140" MinHeight="32"
                          SelectedIndex="0"
                          SelectionChanged="ScopeSelector_SelectionChanged">
                    <ComboBoxItem Content="全部脚本" />
                    <ComboBoxItem Content="当前账号" />
                </ComboBox>
                <ui:Button MinWidth="72" MinHeight="32" Margin="12,0,0,0"
                           Content="刷新" Click="Refresh_Click" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontSize="12"
                           Foreground="{DynamicResource OasTextTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 内容：左列表 + 右详情 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 列表 -->
            <Border Grid.Column="0" CornerRadius="{StaticResource RadiusCard}"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="ErrorList" BorderThickness="0"
                             Background="Transparent" Padding="6"
                             SelectionChanged="ErrorList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4">
                                    <TextBlock Text="{Binding TimeText}" FontSize="13" />
                                    <TextBlock Text="{Binding SubText}" FontSize="11"
                                               Foreground="{DynamicResource OasTextTertiaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Text="没有错误记录"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource OasTextTertiaryBrush}" />
                </Grid>
            </Border>

            <!-- 详情 -->
            <Border Grid.Column="2" CornerRadius="{StaticResource RadiusCard}"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="DetailTitle" Grid.Row="0"
                               Text="选择左侧记录查看详情" FontSize="15"
                               Foreground="{DynamicResource OasTextPrimaryBrush}" />
                    <TextBlock x:Name="DetailMeta" Grid.Row="1" FontSize="11"
                               Margin="0,4,0,8"
                               Foreground="{DynamicResource OasTextTertiaryBrush}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 日志全文 -->
                        <Border Grid.Column="0" CornerRadius="6" Padding="8"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText" FontFamily="Consolas, Microsoft YaHei UI"
                                           FontSize="11" TextWrapping="NoWrap"
                                           Foreground="{DynamicResource OasTextPrimaryBrush}" />
                            </ScrollViewer>
                        </Border>

                        <!-- 截图 -->
                        <ScrollViewer Grid.Column="2" Width="280"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="8,0,0,0">
                            <StackPanel x:Name="ImagePanel" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
