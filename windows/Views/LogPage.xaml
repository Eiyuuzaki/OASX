<UserControl x:Class="OASX.Views.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：标题 + 连接状态（与其他页一致） -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="日志" FontSize="24" FontWeight="SemiBold"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{DynamicResource OasTextPrimaryBrush}" />
                <TextBlock Text="调度器实时输出" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource OasTextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Ellipse x:Name="ConnDot" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{DynamicResource OasTextTertiaryBrush}" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="7,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource OasTextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 工具条：调度器 + 启停 + 自动滚动/清空 -->
        <Border Grid.Row="1" CornerRadius="{StaticResource RadiusCard}" Padding="12"
                Margin="0,0,0,12"
                Background="{DynamicResource OasSurfaceBrush}"
                BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 第 1 行：调度器 + 启停 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="SlideText24" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ScriptSelector" MinWidth="180" MinHeight="32"
                              VerticalAlignment="Center"
                              SelectionChanged="ScriptSelector_SelectionChanged" />
                    <ui:Button x:Name="StartButton" MinWidth="84" MinHeight="32"
                               Margin="10,0,0,0" Click="StartButton_Click"
                               Icon="{ui:SymbolIcon Play24}" Content="启动" />
                    <ui:Button x:Name="StopButton" MinWidth="84" MinHeight="32"
                               Margin="8,0,0,0" Click="StopButton_Click"
                               Icon="{ui:SymbolIcon Stop24}" Content="停止" />
                </StackPanel>

                <!-- 第 2 行：筛选 + 计数 + 自动滚动 + 清空（独立一行，窄窗口也不重叠） -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="级别" FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource OasTextTertiaryBrush}" />
                    <ComboBox x:Name="LevelFilter" MinWidth="120" MinHeight="32"
                              VerticalAlignment="Center"
                              SelectedIndex="0"
                              SelectionChanged="LevelFilter_SelectionChanged">
                        <ComboBoxItem Content="全部级别" />
                        <ComboBoxItem Content="警告+错误" />
                        <ComboBoxItem Content="仅错误" />
                    </ComboBox>
                    <TextBlock x:Name="LineCountText" Text="" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource OasTextTertiaryBrush}" />
                    <ui:ToggleSwitch x:Name="AutoScrollSwitch" VerticalAlignment="Center"
                                     Margin="12,0,0,0"
                                     IsChecked="True" Content="自动滚动" />
                    <ui:Button MinWidth="72" MinHeight="32" Margin="12,0,0,0"
                               Content="清空" Click="ClearButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 日志区域 -->
        <Border Grid.Row="2" CornerRadius="{StaticResource RadiusCard}"
                Background="{DynamicResource OasSurfaceBrush}"
                BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
            <Grid>
                <ListBox x:Name="LogList"
                         SelectionMode="Single"
                         BorderThickness="0"
                         Padding="10,8"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.ScrollChanged="LogList_ScrollChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- 分段着色：时间戳(青) / 级别(蓝/黄/红) / 正文(默认) -->
                            <TextBlock TextWrapping="NoWrap"
                                       FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                       FontSize="12.5">
                                <Run Text="{Binding Time, Mode=OneWay}"
                                     Foreground="{DynamicResource OasLogTimeBrush}" /><Run
                                     Text="{Binding Level, Mode=OneWay}"
                                     Foreground="{Binding LevelBrush}" /><Run
                                     Text="{Binding Rest, Mode=OneWay}"
                                     Foreground="{DynamicResource OasTextPrimaryBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <!-- 空态 -->
                <TextBlock x:Name="EmptyText" Text="暂无日志输出——启动任务后在此实时显示"
                           FontSize="12" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource OasTextTertiaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>