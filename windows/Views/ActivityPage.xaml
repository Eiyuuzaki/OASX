<UserControl x:Class="OASX.Views.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">

            <!-- 页头 -->
            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="活动" FontSize="24" FontWeight="SemiBold"
                               FontFamily="{StaticResource AppFontFamily}"
                               Foreground="{DynamicResource OasTextPrimaryBrush}" />
                    <TextBlock x:Name="SubtitleText" Text="每日/每周任务 · 完成状态自动判定"
                               FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource OasTextSecondaryBrush}" />
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" MinWidth="40"
                           ToolTip="刷新（重读游戏客户端）" Click="Refresh_Click" />
            </Grid>

            <!-- 概览 -->
            <Border CornerRadius="{StaticResource RadiusCard}" Padding="16" Margin="0,0,0,14"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PersonAccounts24" FontSize="24"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AccountText" Text="未选择账号" FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
                            <TextBlock x:Name="ServerText" Text="" FontSize="12"
                                       Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="每日" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        <TextBlock x:Name="DailySummaryText" Text="—" FontSize="22"
                                   FontWeight="SemiBold" Margin="8,0,16,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   Foreground="{DynamicResource OasAccentBrush}" />
                        <TextBlock Text="悬赏" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        <TextBlock x:Name="MonsterSummaryText" Text="—" FontSize="22"
                                   FontWeight="SemiBold" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   Foreground="{DynamicResource OasWarningBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="LiveRoleText" Text="" FontSize="12" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource OasTextSecondaryBrush}" />

            <!-- 结界寄养：自结界卡 + 寄养 双卡并排（圆环进度，6h 一收，到点推送） -->
            <Grid Margin="0,10,0,6">
                <TextBlock Text="结界寄养" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource OasTextPrimaryBrush}" />
                <TextBlock x:Name="FosterNotifyText" Text="" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource OasTextSecondaryBrush}" />
            </Grid>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 自结界卡 -->
                <Border CornerRadius="{StaticResource RadiusCard}" Padding="16,14"
                        Background="{DynamicResource OasSurfaceBrush}"
                        BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="52" Height="52" VerticalAlignment="Top">
                                <Ellipse x:Name="ActOwnRingTrack" Width="52" Height="52"
                                         Stroke="{DynamicResource OasBorderBrush}" StrokeThickness="4" />
                                <Ellipse x:Name="ActOwnRing" Width="52" Height="52"
                                         Stroke="{DynamicResource OasAccentBrush}" StrokeThickness="4"
                                         StrokeDashCap="Round">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90" CenterX="26" CenterY="26" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Image x:Name="ActOwnIcon" Width="32" Height="32"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ui:SymbolIcon x:Name="ActOwnPlaceholder" Symbol="Add24" FontSize="20"
                                               Foreground="{DynamicResource OasTextTertiaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="自结界卡" FontSize="12"
                                           Foreground="{DynamicResource OasTextTertiaryBrush}" />
                                <TextBlock x:Name="ActOwnName" Text="—" FontSize="15" FontWeight="SemiBold"
                                           Margin="0,2,0,0"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                <TextBlock x:Name="ActOwnNote" Text="" FontSize="11" Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource OasTextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ActOwnCountdown" Text="" FontSize="20" FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   Foreground="{DynamicResource OasAccentBrush}" />
                        <TextBlock x:Name="ActOwnEnd" Text="" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource OasTextTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 寄养 -->
                <Border Grid.Column="2" CornerRadius="{StaticResource RadiusCard}" Padding="16,14"
                        Background="{DynamicResource OasSurfaceBrush}"
                        BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="52" Height="52" VerticalAlignment="Top">
                                <Ellipse x:Name="ActFosterRingTrack" Width="52" Height="52"
                                         Stroke="{DynamicResource OasBorderBrush}" StrokeThickness="4" />
                                <Ellipse x:Name="ActFosterRing" Width="52" Height="52"
                                         Stroke="{DynamicResource OasAccentBrush}" StrokeThickness="4"
                                         StrokeDashCap="Round">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90" CenterX="26" CenterY="26" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Image x:Name="ActFosterIcon" Width="32" Height="32"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ui:SymbolIcon x:Name="ActFosterPlaceholder" Symbol="Add24" FontSize="20"
                                               Foreground="{DynamicResource OasTextTertiaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="寄养" FontSize="12"
                                           Foreground="{DynamicResource OasTextTertiaryBrush}" />
                                <TextBlock x:Name="ActFosterName" Text="—" FontSize="15" FontWeight="SemiBold"
                                           Margin="0,2,0,0"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                <TextBlock x:Name="ActFosterLive" Text="" FontSize="11" Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource OasTextSecondaryBrush}" />
                                <TextBlock x:Name="ActFosterNotify" Text="" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource OasTextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ActFosterCountdown" Text="" FontSize="20" FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   Foreground="{DynamicResource OasAccentBrush}" />
                        <TextBlock x:Name="ActFosterEnd" Text="" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource OasTextTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>


            <!-- 每日任务 -->
            <TextBlock Text="每日任务" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"
                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
            <ItemsControl x:Name="DailyList" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="{StaticResource RadiusCard}" Padding="14,10"
                                Margin="0,0,0,6"
                                Background="{DynamicResource OasSurfaceBrush}"
                                BorderBrush="{DynamicResource OasBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding StateSymbol}"
                                               FontSize="16" VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{Binding StateBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgressText}" FontSize="13"
                                               FontWeight="SemiBold" Margin="0,0,12,0"
                                               FontFamily="{StaticResource AppFontFamily}"
                                               Foreground="{Binding StateBrush}" />
                                    <TextBlock Text="{Binding ScoreText}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource OasAccentBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 悬赏封印 -->
            <TextBlock Text="悬赏封印" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,6"
                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
            <ItemsControl x:Name="MonsterList" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="{StaticResource RadiusCard}" Padding="14,10"
                                Margin="0,0,0,6"
                                Background="{DynamicResource OasSurfaceBrush}"
                                BorderBrush="{DynamicResource OasBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding StateSymbol}"
                                               FontSize="16" VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{Binding StateBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding ProgressText}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           Foreground="{Binding StateBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 每周任务（周常）：游戏内无面板，按社区清单手动勾选 -->
            <Grid Margin="0,10,0,6">
                <TextBlock Text="每周任务（周常）" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource OasTextPrimaryBrush}" />
                <TextBlock x:Name="WeeklySummaryText" Text="" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource OasTextSecondaryBrush}" />
            </Grid>
            <Border CornerRadius="{StaticResource RadiusCard}" Padding="16" Margin="0,0,0,6"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="游戏内没有周常面板，这里是社区常用清单；勾选记录本地保存，周一 5:00 自动重置。"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                               Foreground="{DynamicResource OasTextTertiaryBrush}" />
                    <ItemsControl x:Name="WeeklyList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Done, Mode=TwoWay}"
                                          Margin="0,5" FontSize="13"
                                          Foreground="{DynamicResource OasTextPrimaryBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="13"
                                                   Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Note}" FontSize="11"
                                                   Foreground="{DynamicResource OasTextTertiaryBrush}" />
                                        <TextBlock Text="{Binding SignalText}" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Visibility="{Binding SignalVisibility}"
                                                   Foreground="{DynamicResource OasAccentBrush}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- 进行中的活动时段 -->
            <TextBlock Text="进行中的活动时段" FontSize="14" FontWeight="SemiBold"
                       Margin="0,10,0,6"
                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
            <Border CornerRadius="{StaticResource RadiusCard}" Padding="16" Margin="0,0,0,6"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="LiveEmptyText" Text="当前没有进行中的时段"
                               FontSize="12"
                               Foreground="{DynamicResource OasTextTertiaryBrush}" />
                    <ItemsControl x:Name="LiveList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3" Background="Transparent"
                                      Cursor="Hand" ToolTip="双击给这个时段起个中文名"
                                      MouseLeftButtonDown="LiveRow_DoubleClick">
                                    <TextBlock Text="{Binding Label}" FontSize="13"
                                               Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding EndText}" HorizontalAlignment="Right"
                                               FontSize="13" FontWeight="SemiBold"
                                               FontFamily="{StaticResource AppFontFamily}"
                                               Foreground="{DynamicResource OasTextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="注：客户端只给内部 key；双击任意行可起中文名（本地保存）"
                               FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource OasTextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 当前活动 -->
            <TextBlock Text="当前活动" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,6"
                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
            <Border CornerRadius="{StaticResource RadiusCard}" Padding="16" Margin="0,0,0,6"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <ItemsControl x:Name="ActivityList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                <TextBlock Text="{Binding EndText}" HorizontalAlignment="Right"
                                           FontSize="12"
                                           Foreground="{DynamicResource OasTextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 活动任务（需游戏内打开活动页） -->
            <TextBlock Text="活动任务" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,6"
                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
            <Border CornerRadius="{StaticResource RadiusCard}" Padding="16" Margin="0,0,0,8"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <TextBlock x:Name="ActivityText" Text="—" FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource OasTextSecondaryBrush}" />
            </Border>

            <TextBlock x:Name="StatusText" Text="" FontSize="11" Margin="0,4,0,8"
                       Foreground="{DynamicResource OasTextTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>