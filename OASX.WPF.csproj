<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>OASX</RootNamespace>
    <AssemblyName>oasx</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- BGI（BetterGenshinImpact）同款 UI 库：WPF-UI 4.3.0。
         NavigationView / FluentWindow / TitleBar / Mica 全部内置，
         且控件源码开放——出 bug 我们能自己读源码修，不必等框架作者。 -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- 托盘图标（4.x 拆分为独立包） -->
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/appicon.png" />
    <Resource Include="Assets/currency/*.png" />
    <!-- Content 复制到输出目录：CurrencyIconRegistry 运行时枚举磁盘白名单用 -->
    <Content Include="Assets/currency/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 每次构建自动签名：未签名 exe 会触发"打开文件 - 安全警告"
       （无法验证发布者），签名后该弹窗整条消失。
       证书 CN=OASX Dev 为本机自签名（CurrentUser/My + TrustedPeople），
       正式对外分发时换真证书并改用 /n 匹配的颁发者。 -->
  <Target Name="SignOutput" AfterTargets="Build"
          Condition="Exists('$(TargetPath)') And Exists('C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe')">
    <Exec Command="&quot;C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe&quot; sign /fd SHA256 /n &quot;OASX Dev&quot; &quot;$(TargetDir)$(AssemblyName).exe&quot;"
          ContinueOnError="true" />
  </Target>

</Project>
