<ui:FluentWindow x:Class="OASX.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:OASX.Views"
                 mc:Ignorable="d"
                 Title="OASX"
                 Width="1050" Height="700"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OASX">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/appicon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- BGI 同款结构：NavigationView 内部自带 Frame + 页面服务导航。
             不用 ContentOverlay 自管 Frame——那会替换掉内部内容管线，
             条目点击的导航事件链整个断掉（实测踩坑）。 -->
        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNavigation"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           IsTopSeparatorVisible="False"
                           IsFooterSeparatorVisible="False"
                           OpenPaneLength="160">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="仪表盘" TargetPageType="{x:Type views:DashboardPage}"
                                       Icon="{ui:SymbolIcon Home24}" />
                <ui:NavigationViewItem Content="工作台" TargetPageType="{x:Type views:WorkbenchPage}"
                                       Icon="{ui:SymbolIcon Rocket24}" />
                <ui:NavigationViewItem Content="统计" TargetPageType="{x:Type views:StubPage}"
                                       Icon="{ui:SymbolIcon DataHistogram24}" />
                <ui:NavigationViewItem Content="资产" TargetPageType="{x:Type views:StubPage}"
                                       Icon="{ui:SymbolIcon Wallet24}" />
                <ui:NavigationViewItem Content="日志" TargetPageType="{x:Type views:LogPage}"
                                       Icon="{ui:SymbolIcon SlideText24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="设置" TargetPageType="{x:Type views:SettingsPage}"
                                       Icon="{ui:SymbolIcon Settings24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
