<UserControl x:Class="OASX.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置" FontSize="20" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" MaxWidth="720" HorizontalAlignment="Left">

            <Border CornerRadius="8" Padding="16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="OAS 后端地址" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="OASX 通过 HTTP/SSE 连接该地址（默认 http://127.0.0.1:22288）"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="BackendBox" MinHeight="34"
                                    PlaceholderText="http://127.0.0.1:22288" />
                        <Button Grid.Column="1" Click="SaveBackend_Click"
                               
                                Margin="8,0,0,0">保存</Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="主题" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="浅色 / 深色 / 跟随系统" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" x:Name="ThemeSelector" MinWidth="140"
                              MinHeight="34" SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBoxItem Tag="system">跟随系统</ComboBoxItem>
                        <ComboBoxItem Tag="light">浅色</ComboBoxItem>
                        <ComboBoxItem Tag="dark">深色</ComboBoxItem>
                    </ComboBox>
                </Grid>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
