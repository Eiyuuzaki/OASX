<UserControl x:Class="OASX.Views.WorkbenchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32,20,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左栏：配置列表（对应 Flutter 的 ConfigCollectionPanel） -->
        <Border Grid.Column="0" CornerRadius="8" Padding="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="8,4,8,8">
                    <TextBlock Text="配置" FontWeight="SemiBold" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <ui:Button Icon="{ui:SymbolIcon Add24}" Padding="6" Margin="2,0,0,0"
                                   Background="Transparent" BorderThickness="0"
                                   ToolTip="新建配置（以 template 为模板）"
                                   Click="ConfigAdd_Click" />
                        <ui:Button Icon="{ui:SymbolIcon Edit24}" Padding="6" Margin="2,0,0,0"
                                   Background="Transparent" BorderThickness="0"
                                   ToolTip="重命名当前配置"
                                   Click="ConfigRename_Click" />
                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Padding="6" Margin="2,0,0,0"
                                   Background="Transparent" BorderThickness="0"
                                   ToolTip="删除当前配置"
                                   Click="ConfigDelete_Click" />
                    </StackPanel>
                </DockPanel>
                <ListBox Grid.Row="1" x:Name="ConfigList"
                         SelectionMode="Single" BorderThickness="0" Background="Transparent"
                         SelectionChanged="ConfigList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="4,6" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右栏：概览（状态卡+任务分组） ↔ 参数编辑页 -->
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 脚本状态卡（两种视图下都显示） -->
            <Border Grid.Row="0" CornerRadius="8" Padding="16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ScriptNameText" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="StateText" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="StartButton" Click="StartButton_Click" MinWidth="88"
                                Margin="0,0,8,0">启动</Button>
                        <Button x:Name="StopButton" Click="StopButton_Click" MinWidth="88">停止</Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 概览：任务分组列表 -->
            <Border Grid.Row="1" x:Name="OverviewPanel" Margin="0,12,0,0" CornerRadius="8" Padding="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="任务（点击进入参数编辑）" FontWeight="SemiBold" Margin="8,4,0,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TaskGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,2" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Group}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Count}" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Tasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,6" Margin="0,1" CornerRadius="4"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="TaskItem_Click"
                                                            Tag="{Binding Name}">
                                                        <DockPanel>
                                                            <ui:Button DockPanel.Dock="Right"
                                                                       Icon="{ui:SymbolIcon Play24}" Padding="2"
                                                                       Background="Transparent"
                                                                       BorderThickness="0"
                                                                       ToolTip="调度此任务立即执行（脚本运行中有效）"
                                                                       Click="TaskRunNow_Click"
                                                                       Tag="{Binding Name}" />
                                                            <TextBlock Text="{Binding Display}" FontSize="13"
                                                                       VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 参数编辑页宿主（点击任务时显示） -->
            <Border Grid.Row="1" x:Name="ArgsHostPanel" Margin="0,12,0,0" Visibility="Collapsed"
                    CornerRadius="8" Padding="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:Button Grid.Row="0" Icon="{ui:SymbolIcon ArrowLeft24}" Content="返回任务列表" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Click="BackToOverview_Click" />
                    <!-- Page 只能挂在 Window/Frame 里——宿主必须是 Frame -->
                    <Frame Grid.Row="1" x:Name="ArgsFrame"
                           NavigationUIVisibility="Hidden" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
