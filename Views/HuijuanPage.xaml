<UserControl x:Class="OASX.Views.HuijuanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Unloaded="Page_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">

            <!-- 页头：标题 + 活动状态 + 刷新 -->
            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="绘卷" FontSize="24" FontWeight="SemiBold"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   Foreground="{DynamicResource OasTextPrimaryBrush}" />
                        <Border x:Name="StatusBadge" CornerRadius="4" Padding="8,2" Margin="10,4,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource OasSurfaceSecondaryBrush}">
                            <TextBlock x:Name="StatusBadgeText" Text="—" FontSize="11"
                                       Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" Text="本区服绘卷进度（数据来自运行中的游戏客户端）"
                               FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource OasTextSecondaryBrush}" />
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" MinWidth="40"
                           ToolTip="刷新（强制重读客户端缓存）" Click="Refresh_Click" />
            </Grid>

            <!-- 当前账号 + 期数 -->
            <Border CornerRadius="{StaticResource RadiusCard}" Padding="12" Margin="0,0,0,12"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PersonAccounts24" FontSize="26"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AccountNameText" Text="未选择账号" FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
                            <TextBlock x:Name="AccountDetailText" Text="在资产页选择账号"
                                       FontSize="12"
                                       Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="本期" FontSize="12"
                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        <TextBlock x:Name="IssueText" Text="—" FontSize="22" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   Foreground="{DynamicResource OasAccentBrush}" />
                        <TextBlock Text="期" FontSize="12" Margin="4,0,16,0" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        <TextBlock Text="解锁门槛" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        <TextBlock x:Name="ThresholdText" Text="—" FontSize="14" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   Foreground="{DynamicResource OasTextPrimaryBrush}" />
                        <TextBlock x:Name="WindowText" Text="" FontSize="11"
                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OasTextTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 我的参与（活动期才有数据） -->
            <Border x:Name="SelfCard" CornerRadius="{StaticResource RadiusCard}" Padding="10"
                    Margin="0,0,0,10" Visibility="Collapsed"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="我的绘卷" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource OasTextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="总积分" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        <TextBlock x:Name="SelfScoreText" Text="—" FontSize="22" FontWeight="SemiBold"
                                   Margin="8,0,24,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   Foreground="{DynamicResource OasTextPrimaryBrush}" />
                        <TextBlock Text="最佳排名" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        <TextBlock x:Name="SelfRankText" Text="—" FontSize="22" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   Foreground="{DynamicResource OasWarningBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="参与卷" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        <TextBlock x:Name="JoinText" Text="—" FontSize="13" FontWeight="SemiBold"
                                   Margin="6,0,20,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OasTextPrimaryBrush}" />
                        <TextBlock Text="剩余" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                        <TextBlock x:Name="FragmentsPlain" Text="—" FontSize="13" FontWeight="SemiBold"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OasAccentBrush}" />
                        <ItemsControl x:Name="FragmentsControl" VerticalAlignment="Center"
                                      Margin="8,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                        <Image Width="22" Height="22" Margin="0,0,5,0"
                                               Stretch="Uniform" VerticalAlignment="Center"
                                               Source="{Binding IconImage}"
                                               Visibility="{Binding IconVisibility}" />
                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                   Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource OasTextSecondaryBrush}"
                                                   Visibility="{Binding LabelVisibility}" />
                                        <TextBlock Text="{Binding CountText}" FontSize="14"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFontFamily}"
                                                   Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock x:Name="SelfHintText" Text="" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource OasTextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 六卷棋盘 -->
            <TextBlock Text="各卷进度" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource OasTextPrimaryBrush}" />
            <TextBlock x:Name="EmptyText" Text="正在读取…" FontSize="12" Margin="0,0,0,8"
                       Foreground="{DynamicResource OasTextSecondaryBrush}" />
            <ItemsControl x:Name="ScrollList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 两列：与游戏内绘卷面板一致 -->
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="{StaticResource RadiusCard}" Padding="10"
                                Margin="0,0,8,4"
                                Background="{DynamicResource OasSurfaceBrush}"
                                BorderBrush="{DynamicResource OasBorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <!-- 一行：序号 + 卷名 + 状态 ｜ 百分比 -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="4" Padding="5,1" Margin="0,2,8,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource OasAccentBrush}">
                                            <TextBlock Text="{Binding IndexText}" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{StaticResource AppFontFamily}"
                                                       Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="15"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                        <Border CornerRadius="4" Padding="6,1" Margin="8,2,0,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource OasSurfaceSecondaryBrush}">
                                            <TextBlock Text="{Binding StateText}" FontSize="11"
                                                       Foreground="{Binding StateBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Right"
                                               FontSize="19" FontWeight="SemiBold"
                                               FontFamily="{StaticResource AppFontFamily}"
                                               Foreground="{DynamicResource OasAccentBrush}" />
                                </Grid>
                                <ProgressBar Height="5" Margin="0,7,0,7" Minimum="0" Maximum="100"
                                             Value="{Binding Percent, Mode=OneWay}"
                                             Foreground="{DynamicResource OasAccentBrush}"
                                             Background="{DynamicResource OasSurfaceSecondaryBrush}" />
                                <!-- 一行：我的排名档位 ｜ 我的积分 ｜ 还差 -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RankText}" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Visibility="{Binding RankVisibility}"
                                                   Foreground="{DynamicResource OasWarningBrush}" />
                                        <TextBlock Text="{Binding ScoreText}" FontSize="12"
                                                   Margin="12,0,0,0"
                                                   Visibility="{Binding ScoreVisibility}"
                                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding RemainText}" HorizontalAlignment="Right"
                                               FontSize="12" FontWeight="SemiBold"
                                               Visibility="{Binding RemainVisibility}"
                                               Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>