<UserControl x:Class="OASX.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- 规范 4.2：账号是主上下文（账号卡置顶），调度器状态为次级系统信息 -->
    <ScrollViewer Padding="32,20,32,28" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980">

            <!-- 1. 当前游戏账号（主视觉） -->
            <Border CornerRadius="8" Padding="20" Margin="0,0,0,16"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="PersonAccounts24" FontSize="28"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AccountNameText" Text="未选择账号" FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="AccountDetailText" Text="在资产页选择账号后展示概况"
                                   FontSize="12"
                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. 账号资产快照 -->
            <Border CornerRadius="8" Padding="20" Margin="0,0,0,16"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="资产" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="UpdatedAtText" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                    </Grid>
                    <TextBlock x:Name="EmptyText" Text="该账号暂无资产数据" Visibility="Visible"
                               Foreground="{DynamicResource OasTextSecondaryBrush}" />
                    <ItemsControl x:Name="AssetList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsPanelTemplate>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource OasTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding CountText}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource OasTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DeltaText}" FontSize="12"
                                               Foreground="{Binding DeltaBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. 调度器状态（次级：系统运行信息） -->
            <Border CornerRadius="8" Padding="20"
                    Background="{DynamicResource OasSurfaceBrush}"
                    BorderBrush="{DynamicResource OasBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="TaskSquare24" FontSize="20"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="调度器" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OasTextPrimaryBrush}" />
                        <TextBlock x:Name="SchedulerText" Text="未知" FontSize="12"
                                   Foreground="{DynamicResource OasTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
