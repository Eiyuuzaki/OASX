<UserControl x:Class="OASX.Views.StatisticsPage"
             Unloaded="Page_Unloaded"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具条：配置 + 日期 + 刷新 -->
        <Border Grid.Row="0" CornerRadius="8" Padding="12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="ConfigSelector" MinWidth="150" MinHeight="34"
                          SelectionChanged="ConfigSelector_SelectionChanged" />
                <ui:Button x:Name="PrevDateButton" Icon="{ui:SymbolIcon ChevronLeft24}" MinWidth="40" Margin="12,0,0,0"
                        Click="PrevDate_Click" />
                <ComboBox x:Name="DateSelector" MinWidth="140" MinHeight="34" Margin="8,0,0,0"
                          SelectionChanged="DateSelector_SelectionChanged" />
                <ui:Button x:Name="NextDateButton" Icon="{ui:SymbolIcon ChevronRight24}" MinWidth="40" Margin="8,0,0,0"
                        Click="NextDate_Click" />
                <ui:Button x:Name="RefreshButton" Icon="{ui:SymbolIcon ArrowClockwise24}" MinWidth="40" Margin="12,0,0,0"
                        Click="Refresh_Click" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 汇总磁贴（对应 Flutter _SummaryTiles） -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="8" Padding="16"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="总运行时长" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="RuntimeTile" Text="—" FontSize="22" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" CornerRadius="8" Padding="16"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="任务运行次数" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TaskCountTile" Text="—" FontSize="22" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" CornerRadius="8" Padding="16"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="战斗场次" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="BattleCountTile" Text="—" FontSize="22" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 任务明细：历史趋势 + 每任务 Expander -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Expander Margin="0,0,0,12" IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="历史趋势" FontWeight="SemiBold" />
                            <ComboBox x:Name="MetricSelector" MinWidth="110" MinHeight="30"
                                      Margin="12,0,0,0" FontSize="12"
                                      SelectionChanged="MetricSelector_SelectionChanged">
                                <ComboBoxItem Content="运行时长" IsSelected="True" />
                                <ComboBoxItem Content="任务次数" />
                                <ComboBoxItem Content="战斗场次" />
                            </ComboBox>
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl x:Name="TrendList" Margin="4,4,4,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DateLabel}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Border Grid.Column="1" Height="14" Margin="8,0"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="3">
                                        <Border Width="{Binding BarWidth}" HorizontalAlignment="Left"
                                                Background="{DynamicResource SystemFillColorSuccessBrush}"
                                                CornerRadius="3" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding ValueLabel}"
                                               FontSize="12" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <TextBlock x:Name="EmptyText" Text="该日期无统计数据" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,8" />
                <ItemsControl x:Name="TaskList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="0,0,0,8">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" Margin="12,0,0,0"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Runs}" Margin="12,4,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,5" Margin="0,1" CornerRadius="4"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding Text}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
