<UserControl x:Class="OASX.Views.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具条：配置 + 日期 + 刷新 -->
        <Border Grid.Row="0" CornerRadius="8" Padding="12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="ConfigSelector" MinWidth="150" MinHeight="34"
                          SelectionChanged="ConfigSelector_SelectionChanged" />
                <Button x:Name="PrevDateButton" Content="←" MinWidth="40" Margin="12,0,0,0"
                        Click="PrevDate_Click" />
                <ComboBox x:Name="DateSelector" MinWidth="140" MinHeight="34" Margin="8,0,0,0"
                          SelectionChanged="DateSelector_SelectionChanged" />
                <Button x:Name="NextDateButton" Content="→" MinWidth="40" Margin="8,0,0,0"
                        Click="NextDate_Click" />
                <Button x:Name="RefreshButton" Content="↻" MinWidth="40" Margin="12,0,0,0"
                        Click="Refresh_Click" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 汇总磁贴（对应 Flutter _SummaryTiles） -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="8" Padding="16"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="总运行时长" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="RuntimeTile" Text="—" FontSize="22" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" CornerRadius="8" Padding="16"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="任务运行次数" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TaskCountTile" Text="—" FontSize="22" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" CornerRadius="8" Padding="16"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="战斗场次" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="BattleCountTile" Text="—" FontSize="22" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 任务明细：每个任务一个 Expander（运行次数/总时长 + 每次运行起止） -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyText" Text="该日期无统计数据" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,8" />
                <ItemsControl x:Name="TaskList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="0,0,0,8">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" Margin="12,0,0,0"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Runs}" Margin="12,4,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,5" Margin="0,1" CornerRadius="4"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding Text}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
