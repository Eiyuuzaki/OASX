<UserControl x:Class="OASX.Views.ResourcePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具条：配置选择 + 角色下拉 + 日期下拉（对应 Flutter _Toolbar） -->
        <Border Grid.Row="0" CornerRadius="8" Padding="12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="ConfigSelector" MinWidth="150" MinHeight="34"
                          SelectionChanged="ConfigSelector_SelectionChanged" />
                <ComboBox x:Name="RoleSelector" MinWidth="200" MinHeight="34" Margin="12,0,0,0"
                          SelectionChanged="RoleSelector_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="DateSelector" MinWidth="140" MinHeight="34" Margin="12,0,0,0"
                          SelectionChanged="DateSelector_SelectionChanged" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 资产卡片网格（自适应列数，对应 Flutter _Grid） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyText" Text="暂无数据" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,8" />
                <!-- 不可选网格：用 ItemsControl（WPF ListBox 没有 SelectionMode.None） -->
                <ItemsControl x:Name="AssetCards"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="225" Margin="0,0,8,8" Padding="12" CornerRadius="8"
                                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="36" Height="36" Margin="0,0,10,0"
                                           Source="{Binding IconImage}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CountText}" FontSize="15" FontWeight="Bold" />
                                        <TextBlock Text="{Binding DeltaText}" FontSize="12"
                                                   Foreground="{Binding DeltaBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
