<UserControl x:Class="OASX.Views.ResourcePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具条：配置选择 + 角色信息 + 日期导航 -->
        <Border Grid.Row="0" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="ConfigSelector" MinWidth="160" MinHeight="34"
                          SelectionChanged="ConfigSelector_SelectionChanged" />
                <TextBlock Grid.Column="1" x:Name="RoleText" VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="PrevDateButton" Content="←" MinWidth="40" Margin="0,0,8,0"
                            Click="PrevDate_Click" />
                    <ComboBox x:Name="DateSelector" MinWidth="150" MinHeight="34" Margin="0,0,8,0"
                              SelectionChanged="DateSelector_SelectionChanged" />
                    <Button x:Name="NextDateButton" Content="→" MinWidth="40"
                            Click="NextDate_Click" />
                </StackPanel>
                <Button Grid.Column="4" x:Name="RefreshButton" MinWidth="40" Content="↻"
                        Click="Refresh_Click" />
            </Grid>
        </Border>

        <!-- 资产卡片网格 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" IsEnabled="False"
                             Height="4" Margin="0,0,0,12" />
                <TextBlock x:Name="EmptyText" Text="暂无数据" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ListBox x:Name="AssetCards" SelectionMode="Single" BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180" Margin="0,0,12,12" Padding="12" CornerRadius="8"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="36" Height="36" Margin="0,0,10,0"
                                           Source="{Binding IconImage}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CountText}" FontSize="15"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding DeltaText}" FontSize="12"
                                                   Foreground="{Binding DeltaBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
