<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- OASX 语义色 — 浅色主题（参考 Fluent 2 Light） -->

    <SolidColorBrush x:Key="OasSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OasSurfaceSecondaryBrush" Color="#F8F9FA" />
    <SolidColorBrush x:Key="OasSurfaceTertiaryBrush" Color="#F0F1F3" />
    <SolidColorBrush x:Key="OasBorderBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="OasBorderStrongBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="OasTextPrimaryBrush" Color="#242424" />
    <SolidColorBrush x:Key="OasTextSecondaryBrush" Color="#616161" />
    <SolidColorBrush x:Key="OasTextTertiaryBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="OasAccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="OasSuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="OasWarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="OasDangerBrush" Color="#DC4545" />
</ResourceDictionary>
